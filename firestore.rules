rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dokumen status foto: photos/{slug}
    //  - Slug adalah UUID acak (dianggap "capability token" -> siapapun yang
    //    tahu slug-nya, misal dari scan QR, boleh baca status foto itu).
    //  - BUKAN daftar publik: rule ini tidak mengizinkan `list` koleksi
    //    "photos" tanpa tahu ID dokumennya, jadi orang tidak bisa
    //    mengintip semua foto pengunjung lain.
    //  - Write hanya boleh dari client yang sudah auth (anonim, dari app
    //    Android via FirebaseAuthClient) -> mencegah orang random di
    //    browser console nyampah/mengubah data.
    match /photos/{slug} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if request.auth != null;
    }

    // Daftar admin: dokumen ID = UID akun Firebase Auth (email/password) si
    // admin. Dibuat MANUAL lewat Firestore console (bukan lewat app), lihat
    // SETUP_FIREBASE.md bagian Admin Page. Isi field sembarang, yang penting
    // ID dokumennya sama persis dengan UID.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
